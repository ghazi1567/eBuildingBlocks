{
  "ConnectionStrings": {
    "ReferenceDatabase": "Server=(localdb)\\mssqllocaldb;Database=eBuildingBlocks.ReferenceApp;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Features": {
    "Controllers": { "Enabled": true },
    "ApiVersioning": { "Enabled": true, "DefaultVersion": "1.0" },
    "OpenTelemetry": {
      "Enabled": true,
      "Name": "eBuildingBlocks.ReferenceApp",
      "OtlpUrl": ""
    },
    "Middlewares": {
      "Enabled": true,
      "GlobalException": true,
      "HttpResponse": true
    },
    "Swagger": {
      "Enabled": true,
      "Title": "eBuildingBlocks Reference App",
      "Version": "v1",
      "RoutePrefix": "scalar"
    },
    "Cors": { "Enabled": true, "Policy": "allowall" },
    "Endpoints": {
      "Enabled": true,
      "MapControllers": true,
      "HealthChecks": { "Enabled": true, "Path": "/healthz" },
      "Metrics": { "Enabled": true, "Path": "/metrics" }
    },
    "Metrics": { "Enabled": true, "Path": "/metrics" },
    "Hangfire": {
      "Enabled": true,
      "UseMemoryStorage": true,
      "DashboardPath": "/hangfire",
      "User": "admin",
      "Password": "admin"
    },
    "Authorization": { "Enabled": false },
    "MultiTenancy": {
      "Enabled": true,
      "HeaderName": "X-Tenant-Id",
      "DefaultTenantId": "00000000-0000-0000-0000-000000000000"
    }
  },
  "MassTransit": {
    "UseInMemory": true
  },
  "RabbitMQSettings": {
    "HostName": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "OutboxProcessor": {
    "PollInterval": "00:00:02",
    "BatchSize": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
