{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Features": {
    "Controllers": true,
    "ApiVersioning": {
      "Enabled": true,
      "DefaultVersion": "1.0"
    },
    "Swagger": {
      "Enabled": true,
      "Title": "eBlocksApi",
      "Version": "v1"
    },
    "Cors": {
      "Enabled": true,
      "Policy": "allowall"
    },
    "Endpoints": {
      "MapControllers": true,
      "HealthChecks": {
        "Enabled": true,
        "Path": "/healthz"
      }
    },
    "Middlewares": {
      "Enabled": true,
      "GlobalException": true,
      "HttpResponse": true
    },
    "MultiTenancy": {
      "Enabled": false
    },
    "FluentValidation": true
  }
}
